# Copy to backend/.env (git-ignored) and fill in. Real environment variables
# override this file. Restart `python manage.py runserver` after changing it.

# ---- Development ----
# Debug mode is OFF unless this says true. Never set it on a deployed server.
DJANGO_DEBUG=true

# ---- Where the app runs ----
# The React app (the OAuth flow ends on its /profile page).
FRONTEND_URL=http://localhost:5173
# The origin the browser uses for /api. In development that's the Vite server,
# which proxies /api to Django. Each provider's callback URL is:
#   <OAUTH_REDIRECT_BASE>/api/connect/<gmail|x|facebook|linkedin>/callback/
OAUTH_REDIRECT_BASE=http://localhost:5173

# ---- Linked accounts and "Continue with Google / X" sign-in ----
# App keys from each provider's developer console. Google and X keys also turn on
# sign-in on the login page, using the same callback URL. Leave a pair empty and
# that provider shows as "not set up" (and isn't offered at login).

# Gmail → Google Cloud Console › APIs & Services › Credentials › OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:5173/api/connect/gmail/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X → developer.x.com › Projects & Apps › your app › User authentication settings
#   (OAuth 2.0, type "Web App", confidential client)
#   Callback URI: http://localhost:5173/api/connect/x/callback/
X_CLIENT_ID=
X_CLIENT_SECRET=

# Facebook → developers.facebook.com › My Apps › Create app › Facebook Login
#   Valid OAuth Redirect URI: http://localhost:5173/api/connect/facebook/callback/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# LinkedIn → linkedin.com/developers › Create app › Products: "Sign In with LinkedIn using OpenID Connect"
#   Authorized redirect URL: http://localhost:5173/api/connect/linkedin/callback/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
